<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-android</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>MomentumGroves.Mobile</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationTitle>Momentum Groves</ApplicationTitle>
        <ApplicationId>dk.momentumgroves.privatefood</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="tests\**" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.100" />
        <PackageReference Include="Supabase" Version="8.14.0" />
        <PackageReference Include="ZXing.Net.Maui.Controls" Version="0.4.0" />
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\Images\momentum_groves_logo.png" ForegroundScale="0.72" />
        <MauiImage Include="Resources\Images\momentum_groves_logo.png" />
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#286E58" BaseSize="128,128" />
    </ItemGroup>
</Project>
